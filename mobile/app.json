{
  "expo": {
    "name": "Наушники",
    "slug": "buds-control",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "io.github.ytarmen.buds",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Controls",
              "label": "Наушники: режимы",
              "description": "Заряд CMF Buds и кнопки шумоподавления",
              "minWidth": "250dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-controls.png"
            },
            {
              "name": "Battery",
              "label": "Наушники: заряд",
              "description": "Только заряд CMF Buds и AirPods",
              "minWidth": "250dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-battery.png"
            }
          ]
        }
      ]
    ],
    "owner": "yt_armen",
    "extra": {
      "eas": {
        "projectId": "110ec2ca-4270-488f-a079-fbc20f81696b"
      }
    }
  }
}